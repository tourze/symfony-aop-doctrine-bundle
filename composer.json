{
  "name": "tourze/symfony-aop-doctrine-bundle",
  "description": "Doctrine enhance",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "doctrine/dbal": "^3.7.0 || ^4.0",
    "symfony/http-kernel": "^6.4",
    "symfony/config": "^6.4",
    "symfony/dependency-injection": "^6.4",
    "symfony/yaml": "^6.4 || ^7.1",
    "doctrine/doctrine-bundle": "^2.13",
    "symfony/framework-bundle": "^6.4",
    "tourze/symfony-aop-bundle": "0.0.*",
    "psr/log": "^3|^2|^1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "phpstan": "phpstan analyse src -l 1"
  },
  "autoload": {
    "psr-4": {
      "Tourze\\Symfony\\AopDoctrineBundle\\": "src"
    }
  }
}